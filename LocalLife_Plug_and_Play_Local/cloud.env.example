# Load these with: set -a; source cloud.env; set +a
LOCALLIFE_GCP_PROJECT=locallife-thesis-depth
LOCALLIFE_BUCKET=gs://locallife-thesis-depth-data
LOCALLIFE_RESULTS_DIR=$HOME/LocalLife_Plug_and_Play_Data
# --- Cloud deployment (Windows launcher -> gpu.py -> GCP GPU VM) ---
# true when the Windows launcher was started in Cloud mode. The backend runs
# the same pipeline either way; this only tells the operator page which mode it
# is in. The launcher sets these automatically -- set them by hand only when
# starting the server yourself.
CLOUD_ENABLED=false
LOCALLIFE_VM_NAME=depth-l4
LOCALLIFE_VM_ZONE=europe-west4-a
LOCALLIFE_PI_HOST=locallife@locallife.local
# Set by the launcher once it knows the VM state; left empty the page shows
# "unknown" rather than inventing a status.
LOCALLIFE_VM_STATUS=

LOCALLIFE_HOST=127.0.0.1
LOCALLIFE_PORT=8100

# Temporary Phase 1B geometry-validation mode. It accepts the annotated
# household test objects, but hard-disables waste-ledger and auto-deposit
# writes. Change this back to `waste` after geometry validation to restore
# strict plastic-bag, paper-bag, and cardboard-box classification.
LOCALLIFE_OPERATING_MODE=geometry_validation
# Optional comma-separated override; the built-in validation bank already
# includes the objects in parameterised_objects/reference_objects.csv.
# LOCALLIFE_VALIDATION_PROMPTS="backpack,laptop bag,laundry hamper,shoe,bottle,cardboard box,plastic bag"

# Recognize waste bags/sacks AND rigid cardboard boxes/cartons -- generic
# shopping/paper-bag prompts caused the laptop, chair, shelf, and bottle
# false detections seen in an earlier live trial, so the vocabulary stays
# curated to waste-container terms plus the same explicit non-waste
# lookalikes (used as *negative* prompts -- see NEGATIVE_WASTE_LABELS /
# reject_prompt_conflicts() in pipeline.py -- so the detector can recognize
# and explicitly reject a pillow/chair/bottle instead of never seeing it).
# LiveFix 6 fix: this file previously shipped with LOCALLIFE_BAG_ONLY=true and
# no box/carton/parcel prompt terms at all -- structurally correct for the
# bag-only station in BAG_STATION.md, but it silently meant a rigid box or
# carton (this project's current thesis priority target, per the "LLM-Ready
# Dual-Camera Volume Fix Build Specification": 1 L / 1.5 L / 2 L test
# cartons) could never be detected at all under this example config, however
# correct estimate_box_volume_cuboid()'s own math is -- no detection, no
# mask, no volume, ever, regardless of the geometry. Boxes are now enabled
# by default here; set LOCALLIFE_BAG_ONLY=true yourself if you deliberately
# want the specialized bag-only station instead.
LOCALLIFE_DETECTOR_MODEL=yoloe-11l-seg.pt
LOCALLIFE_PROMPTS="plastic garbage bag,plastic trash bag,filled plastic waste bag,polythene waste bag,transparent plastic waste bag,paper waste bag,kraft paper bag,paper shopping bag,cardboard box,cardboard shipping box,carton box,milk carton,drink carton"
LOCALLIFE_NEGATIVE_PROMPTS="backpack,rucksack,laptop bag,briefcase,duffel bag,sports bag,handbag,purse,shoe,sneaker,sandal,slipper,boot,pillow,cushion,blanket,bedding,clothing,bottle,lotion bottle,soda can,aluminium drink can,tin can,chair,furniture,person,hand,foot,laundry basket,laundry hamper,fabric storage basket,curtain,drape,chair cover,floor mat,rug,power cable,power adapter,power strip,charger,door"
LOCALLIFE_CONF=0.24
LOCALLIFE_IMAGE_SIZE=960
# false (not true): recognize both bags and boxes. See the LiveFix 6 comment
# above -- flip to true only for the specialized fixed-bin bag-only station.
LOCALLIFE_BAG_ONLY=false
# Preserve the working, low-false-positive configuration: require model recognition.
LOCALLIFE_ALLOW_UNCLASSIFIED=false
LOCALLIFE_MIN_PIXELS=700
LOCALLIFE_MIN_DETECTION_AREA_FRACTION=0.003
LOCALLIFE_MAX_DETECTION_AREA_FRACTION=0.62
LOCALLIFE_MIN_DETECTION_SIDE_FRACTION=0.035
LOCALLIFE_TRACK_CONFIRM=2
LOCALLIFE_TRACK_MISSING=24
LOCALLIFE_TRACK_PREDICTION_FRAMES=6
LOCALLIFE_TRACK_MIN_IOU=0.08
LOCALLIFE_TRACK_MAX_CENTER_DISTANCE=0.38
LOCALLIFE_AUTO_DEPOSIT=true
LOCALLIFE_SETTLE_FRAMES=5
LOCALLIFE_SETTLE_TOLERANCE=0.12
LOCALLIFE_VOLUME_STABILITY_FRAMES=3
LOCALLIFE_HISTORY_LIMIT=100
# Set these only after confirming the plant's real color conventions:
# LOCALLIFE_COLOR_MAP="blue:plastic,green:organic,black:general waste"

# Optional comparison-only monocular depth. RealSense remains the sole metric
# geometry authority, so this expensive model is disabled by default locally.
LOCALLIFE_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Indoor-Large-hf
LOCALLIFE_ENABLE_DEPTH=true
LOCALLIFE_DEVICE=auto
LOCALLIFE_HALF=true
LOCALLIFE_BATCH_SIZE=6

# Baseline-subtracted volume and durable Cloud Storage synchronization.
LOCALLIFE_ROI=0.05,0.05,0.90,0.90
LOCALLIFE_BASELINE_FRAMES=9
LOCALLIFE_VOLUME_FRAMES=5
LOCALLIFE_MIN_DEPTH_COVERAGE=0.70
LOCALLIFE_MIN_FOREGROUND_FRACTION=0.12
LOCALLIFE_DEPTH_NOISE_M=0.004
# Whether depositing an object rewrites the scene reference so it counts as
# background afterwards. It mutates the reference that detection and volume both
# subtract from, while the object is still in frame -- fine for a bin whose
# contents stay put, ruinous for sequential testing where each object is taken
# away again (after several objects the reference is a collage of all of them
# and the largest "changed" region is background). Playbook sections 4 and 10
# require the empty-bin calibration to stay fixed; incremental volume now comes
# from added_volume_l instead. Enable only for a true fixed bag station.
LOCALLIFE_ADVANCE_REFERENCE_ON_DEPOSIT=false
# A support plane is valid only for the pose it was fitted at. Beyond these the
# calibration is marked invalid and camera_moved_recalibration_required is
# raised, instead of silently reusing an old plane at a new camera placement.
LOCALLIFE_CAMERA_MOVE_MAX_TILT_DEG=3.0
LOCALLIFE_CAMERA_MOVE_MAX_DISTANCE_M=0.05
# The Final Implementation Playbook's locked volume method (sections 3-7):
# backproject depth to 3-D, take each point's perpendicular height above the
# calibrated bin floor, bin those points into fixed physical cells on that
# floor, and integrate a robust per-cell median height times the constant cell
# area. Every earlier mode integrated once per pixel instead, weighting each
# pixel by z^2/(fx*fy) -- the footprint of a ray meeting a surface square-on,
# which a crumpled bag's oblique facets are not -- and reference-plane anchored
# that footprint to the reference depth, inflating any object standing proud of
# the floor by (z_reference/z_object)^2. Against closed-form synthetic ground
# truth this cut mean absolute percentage error from about 15% to about 1%.
# Alternatives for controlled thesis sensitivity experiments: reference-plane,
# surface-columns, ray-frustum, triangulated-surface.
LOCALLIFE_VOLUME_GEOMETRY=height-map-grid
# Playbook section 27 tunables. Starting points, not validated constants --
# record the final values after tuning on the real camera and bin. The grid
# grows itself if the depth image cannot support the configured cell size.
LOCALLIFE_VOLUME_GRID_SIZE_M=0.010
LOCALLIFE_VOLUME_MIN_POINTS_PER_CELL=3
# 50 is the median. Section 7 allows evaluating 60-80 if the median is found to
# underestimate wrinkled surfaces -- pick one and freeze it after validation.
LOCALLIFE_VOLUME_CELL_PERCENTILE=50
# Factor learned from a physically measured calibration object; 1.0 means none.
LOCALLIFE_VOLUME_CALIBRATION_FACTOR=1.0
# Correlated alignment, segmentation and camera-calibration uncertainty floor.
LOCALLIFE_SYSTEMATIC_ERROR_FRACTION=0.025
LOCALLIFE_DEPTH_NOISE_SIGMA=3.0
LOCALLIFE_REJECT_DEPTH_OUTLIERS=true
# Reuse the one-time installation profile after a restart. It is accepted only
# when the live camera view still resembles the saved installation.
LOCALLIFE_RESTORE_SAVED_BASELINE=true
LOCALLIFE_SAVED_BASELINE_VALIDATION_FRAMES=3
LOCALLIFE_SAVED_BASELINE_RGB_THRESHOLD=24
LOCALLIFE_SAVED_BASELINE_MAX_CHANGED_FRACTION=0.65
# Show uncertain detections live, but never add them to experiment databases.
LOCALLIFE_RECORD_ONLY_MEASURED=true
LOCALLIFE_AUTOMATIC_BASELINE=true
LOCALLIFE_AUTOMATIC_BASELINE_FRAMES=9
LOCALLIFE_AUTOMATIC_BASELINE_MOTION=3.0
# Measure the Logitech lens-to-empty-bin distance with a tape measure and set it.
# Without this value, Logitech liters and deposits are blocked; no scale is invented.
# LOCALLIFE_LOGITECH_REFERENCE_DISTANCE_M=1.85
LOCALLIFE_LOGITECH_REQUIRE_REFERENCE=true
# Provisional (uncalibrated) Logitech litres are off: without a measured
# reference, Depth Anything V2 depth is relative only and no litres are
# reported. Set true only for a labelled demonstration, never for thesis data;
# such rows carry calibration_method=model-metric-unverified.
LOCALLIFE_LOGITECH_ALLOW_PROVISIONAL_METRIC=false
# Thesis research mode: paired (RealSense and Logitech side by side),
# realsense_only or logitech_only. Fusion is never part of any of them.
LOCALLIFE_RESEARCH_MODE=paired
# Finalised measurements from the two cameras this close in time are grouped
# as one physical object (one comparison_event_id).
LOCALLIFE_COMPARISON_PAIR_WINDOW_S=20
LOCALLIFE_LOGITECH_PROVISIONAL_SYSTEMATIC_ERROR_FRACTION=0.35
LOCALLIFE_LOGITECH_REQUIRE_OVERHEAD=true
LOCALLIFE_LOGITECH_MAX_TILT_DEG=35
LOCALLIFE_LOGITECH_HORIZONTAL_FOV_DEG=70.42
# Logitech has a different viewpoint; constrain it without changing RealSense.
# Example only: LOCALLIFE_LOGITECH_ROI=0.30,0.15,0.65,0.75
LOCALLIFE_LOGITECH_MAX_SCENE_FRACTION=0.45
LOCALLIFE_LOGITECH_MAX_MASK_EXPANSION=2.0
LOCALLIFE_LOGITECH_DUPLICATE_OVERLAP=0.55
LOCALLIFE_LOGITECH_MIN_VALID_HEIGHT_FRACTION=0.35
LOCALLIFE_LOGITECH_MAX_ITEM_VOLUME_L=90
LOCALLIFE_REALSENSE_MAX_ITEM_VOLUME_L=90
LOCALLIFE_LOGITECH_STABILIZE_DEPTH=true
LOCALLIFE_COMPARISON_MATCH_SECONDS=8.0
# Optional: calibrated opening polygon, using normalized x:y vertices.
# LOCALLIFE_BIN_POLYGON=0.12:0.10,0.88:0.10,0.91:0.91,0.09:0.91
# Optional: physical bin capacity in liters, if independently known.
# LOCALLIFE_BIN_CAPACITY_L=660
LOCALLIFE_MIN_HEIGHT_M=0.025
# Validation-only lower gate for the annotated 20 mm laptop sleeve.
LOCALLIFE_VALIDATION_MIN_HEIGHT_M=0.010
LOCALLIFE_MAX_HEIGHT_M=0.80
LOCALLIFE_BUCKET_SYNC=true
LOCALLIFE_SYNC_INTERVAL=180

# Required if you deliberately bind the service to 0.0.0.0.
# Prefer an SSH tunnel and leave this unset.
# LOCALLIFE_API_TOKEN=replace-with-a-long-random-secret
