# Local Life - configuration template. Placeholders only; never commit real values.
# Copy to .env (git-ignored) or export these before starting the launcher.

# --- Run mode ---------------------------------------------------------------
# ask | local | cloud | auto. "ask" shows the welcome page and lets the
# operator choose.
DEFAULT_RUN_MODE=ask
CLOUD_ENABLED=false
ALLOW_LOCAL_FALLBACK=true
CLOUD_STARTUP_TIMEOUT_SECONDS=90
CLOUD_REQUEST_TIMEOUT_SECONDS=30

# --- Ports ------------------------------------------------------------------
# The control service starts processes, so it binds to 127.0.0.1 only.
LOCAL_API_PORT=8765
DASHBOARD_PORT=8000

# --- Google Cloud -----------------------------------------------------------
# Authentication comes from the Google Cloud CLI login; no key file is used or
# stored by this project.
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=gs://your-bucket-name
GCP_VM_NAME=depth-l4
GCP_PREFERRED_ZONES=europe-west4-a,europe-west4-b,europe-west1-b
CLOUD_API_URL=

# --- Raspberry Pi and cameras ----------------------------------------------
PI_HOST=locallife.local
PI_USER=locallife
PI_PORT=22

# --- Measurement ------------------------------------------------------------
MODEL_PATH=yoloe-11l-seg.pt
# The stream this bin accepts; anything else is reported as a mis-sort.
BIN_WASTE_STREAM=plastic

# --- Cloud startup budgets -------------------------------------------------
# Per-stage timeouts, so a stage that stalls fails with a named reason instead
# of leaving the operator on an endless spinner. Defaults are set from measured
# startup: a real run brought the VM up in 79 s with capacity in the usual zone.
VM_START_TIMEOUT_SECONDS=300
SSH_VERIFY_TIMEOUT_SECONDS=60
BACKEND_READY_TIMEOUT_SECONDS=180
TUNNEL_READY_TIMEOUT_SECONDS=60
PI_CONNECT_TIMEOUT_SECONDS=90
FIRST_FRAME_TIMEOUT_SECONDS=120
ALLOW_LOCAL_FALLBACK=true
